# Copy to gateway.env (Docker) or /etc/telivoz/gateway.env (systemd) and fill in.
# Never commit the filled-in file.

# Encrypts stored vendor passwords. Generate once (openssl rand -hex 32) and keep it safe:
# changing it makes stored vendor passwords unreadable.
GATEWAY_SECRET=

# PostgreSQL connection (systemd install). Docker sets this from POSTGRES_PASSWORD.
DATABASE_URL=postgres://gateway:CHANGE_ME@127.0.0.1:5432/gateway?sslmode=disable

# Listen addresses. During the parallel run use ports the old system does not use.
HTTP_ADDR=:8080
SMPP_ADDR=:2775

# Set to true when the portal is served over HTTPS (it should be).
COOKIE_SECURE=true

# Built portal files (systemd install).
WEB_DIR=/opt/telivoz/web
