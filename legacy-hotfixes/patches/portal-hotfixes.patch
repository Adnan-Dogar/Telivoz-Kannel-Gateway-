+
+    /**
+     * Serializes submits that carry the same client message ID and destination, then returns the ID of an
+     * already stored copy (or false). The lock is released when the request ends.
+     */
+    public static function lockAndFindDuplicate($data) {
+        if (empty($data['messageid']) || empty($data['to'])) {
+            return false;
+        }
+        $lockName = 'sms:' . md5($data['client_id'] . ':' . $data['messageid'] . ':' . $data['to']);
+        $db = \Yii::$app->db;
+        $db->createCommand('SELECT GET_LOCK(:name, 10)', [':name' => $lockName])->queryScalar();
+        register_shutdown_function(function () use ($db, $lockName) {
+            try {
+                $db->createCommand('SELECT RELEASE_LOCK(:name)', [':name' => $lockName])->queryScalar();
+            } catch (\Throwable $e) {
+            }
+        });
+        return self::findDuplicate($data);
+    }
+
+    public static function findDuplicate($data) {
+        if (empty($data['messageid']) || empty($data['to'])) {
+            return false;
+        }
+        $id = (new \yii\db\Query())->select('id')->from('outgoing_sms')
+            ->where(['client_id' => $data['client_id'], 'external_message_id' => $data['messageid'], 'destination' => $data['to']])
+            ->scalar();
+        return $id ?: false;
     }
 
